# Backend Configuration
DATABASE_URL=sqlite+aiosqlite:///./resqai.db
DEBUG=True
DEFAULT_TICK_INTERVAL_MS=500
MAX_TICKS=1000

# Battery Settings
DEFAULT_ROBOT_BATTERY=100.0
BATTERY_RESERVE_THRESHOLD=15.0
MOVEMENT_BATTERY_COST=1.0
RESCUE_BATTERY_COST=5.0

# Grid Defaults
DEFAULT_GRID_COLS=30
DEFAULT_GRID_ROWS=20

# Scoring Weights
SEVERITY_WEIGHT=0.30
TIME_CRITICALITY_WEIGHT=0.25
DETERIORATION_WEIGHT=0.20
HAZARD_EXPOSURE_WEIGHT=0.15
ACCESSIBILITY_WEIGHT=0.10

# CORS (comma separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
